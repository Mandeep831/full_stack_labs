generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  departmentId Int?
  roleId       Int?

  department Department? @relation(fields: [departmentId], references: [id])
  role       Role?       @relation(fields: [roleId], references: [id])
}

model Role {
  id        Int        @id @default(autoincrement())
  title     String     @unique
  employees Employee[]
}
